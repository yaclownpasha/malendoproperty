[Unit]
Description=Malendo bounded enquiry notification worker (review example, not installed)
After=network-online.target mariadb.service

[Service]
Type=oneshot
# A dedicated existing/approved worker identity and read-only WordPress access must be reviewed.
User=malendo-notifications
Group=malendo-notifications
UMask=0077
RuntimeDirectory=malendo-notifications
RuntimeDirectoryMode=0700
Environment=MALENDO_WORDPRESS_ROOT=/srv/malendo-recovery/site
Environment=MALENDO_NOTIFICATION_LOCK=/run/malendo-notifications/worker.lock
Environment=MALENDO_GMAIL_CREDENTIALS=/etc/malendo-notifications/oauth.json
Environment=MALENDO_GMAIL_TRANSPORT=disabled
ExecStart=/usr/bin/php /opt/malendo-notifications/worker.php --run
TimeoutStartSec=150
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# No timer, identity, credential file or permission is installed by this PR.

